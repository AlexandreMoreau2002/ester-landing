# ESTER SAS — Variables d'environnement de build
#
# Ces valeurs sont lues par scripts/generate-data.mjs pendant npm run build.
# Elles ne sont jamais injectées dans le JavaScript client.
#
# dev  : utilise les avis Google de repli et génère une réalisation fictive, sans token.
# prod : comportement par défaut ; utilise Google Places si sa clé est renseignée.
# En prod, les réalisations restent vides au build et viennent de Notion au runtime.
# En développement Vite seulement, un échec API autorise le repli JSON local
# vers la réalisation fictive générée avec ESTER_MODE=dev.
ESTER_MODE=prod

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Version affichée dans la console navigateur au chargement
VITE_APP_VERSION=

# Runtime serveur — GET /api/realisations (server/notion-realisations.mjs)
# À configurer dans Dokploy comme variables runtime, jamais comme build args.
# Cache mémoire : 15 secondes ; dernière réponse conservée si Notion échoue.
# Navigateur visible : lecture toutes les 30 s, soit environ 45 s de délai maximal
# normal cumulé, hors latence et panne.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Endpoint POST /api/contact (server/contact-mail.mjs) — envoi email via Resend
# RESEND_API_KEY   : clé API Resend (compte du propriétaire du domaine)
# CONTACT_TO_EMAIL : adresse qui reçoit les notifications formulaire
# RESEND_FROM      : expéditeur (ex: "ESTER Site Web <contact@ester-sas.fr>")
#                    Si absent, utilise le domaine sandbox Resend (tests uniquement)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM=
