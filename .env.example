# ─────────────────────────────────────────────────────────
# ESTER SAS — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# Ne jamais committer .env dans git.
# ─────────────────────────────────────────────────────────

# ── Notion (intégration CMS réalisations) ────────────────
# Créer une intégration sur https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de la base de données Notion (dans l'URL de la page)
# Ex : https://notion.so/mon-espace/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Formspree (formulaire de contact) ────────────────────
# Créer un form sur https://formspree.io et copier l'endpoint
FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxxxxxx
