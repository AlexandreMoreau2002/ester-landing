# ESTER SAS — Variables d'environnement de build
#
# Ces valeurs sont lues par scripts/generate-data.mjs pendant npm run build.
# Elles ne sont jamais injectées dans le JavaScript client.
#
# dev  : génère des avis Google mockés et garde les réalisations vides si Notion n'est pas configuré.
# prod : comportement par défaut ; les clés ci-dessous sont obligatoires.
ESTER_MODE=prod

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

NOTION_TOKEN=
NOTION_DATABASE_ID=

# Version affichée dans la console navigateur au chargement
VITE_APP_VERSION=

# Netlify Function form-notify — envoi email via Resend
# RESEND_API_KEY   : clé API Resend (compte du propriétaire du domaine)
# CONTACT_TO_EMAIL : adresse qui reçoit les notifications formulaire
# RESEND_FROM      : expéditeur (ex: "ESTER Site Web <contact@ester-bet.fr>")
#                    Si absent, utilise le domaine sandbox Resend (tests uniquement)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM=
